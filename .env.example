# ─── LLM Council — environment configuration (BYOK: Bring Your Own Key) ───
#
# Copy this file to `.env` (which is git-ignored and must NEVER be committed):
#     cp .env.example .env
# then fill in your own values below. The backend reads these at startup;
# nothing is hardcoded in the source.

# REQUIRED — your API key / token for the LLM gateway.
LLM_API_KEY=PASTE_YOUR_API_KEY_HERE

# Base URL of a gateway that exposes OpenAI-, Anthropic-, and Gemini-compatible
# HTTP APIs under one host. Point this at your own endpoint.
LLM_BASE_URL=http://localhost:6655

# Model identifiers for each council member. Override to match what your
# gateway actually serves.
GPT_MODEL=gpt-5.5
CLAUDE_MODEL=anthropic--claude-4.5-sonnet
GEMINI_MODEL=gemini-3.1-flash-lite

# OPTIONAL — override the full endpoint URLs only if your gateway uses paths
# different from the defaults. If left unset, these are derived from LLM_BASE_URL.
# GPT_URL=https://your-gateway.example/openai/v1/chat/completions
# CLAUDE_URL=https://your-gateway.example/anthropic/v1/messages
# GEMINI_URL=https://your-gateway.example/gemini/v1beta/models/MODEL:generateContent

# OPTIONAL — maximum output tokens for Claude responses.
CLAUDE_MAX_TOKENS=16384
